# sinhaacademy.com on quizwrap.com -> /etc/nginx/sites-available/sinhaacademy.com
# Live copy as of 3 Oct 2026, after `certbot --nginx -d sinhaacademy.com -d www.sinhaacademy.com`
# added the 443 block and the http -> https redirect. Certificate renews automatically.

server {
    server_name sinhaacademy.com www.sinhaacademy.com;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;

    client_max_body_size 1M;

    location / {
        proxy_pass http://127.0.0.1:8520;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_http_version 1.1;
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/sinhaacademy.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/sinhaacademy.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}


server {
    if ($host = www.sinhaacademy.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = sinhaacademy.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name sinhaacademy.com www.sinhaacademy.com;
    return 404; # managed by Certbot




}
